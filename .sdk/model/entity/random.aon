# Entity: random

main: kit: entity: random: {

  alias: field: {}

  fields: [
    {
      name: "id"
      req: false
      short: "Unique identifier for the Woody"
      type: "`$STRING`"
    }
    {
      name: "permalink"
      req: false
      short: "Permanent link to this Woody"
      type: "`$STRING`"
    }
    {
      name: "url"
      req: false
      short: "URL to the Woody image"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "random"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/api/random"
          parts: [
            "api"
            "random"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
