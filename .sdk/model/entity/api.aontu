# Entity: api

main: kit: entity: api: {

  alias: field: {}

  fields: {
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique identifier for the Woody"
      t: "`$STRING`"
    }
    permalink: {
      fo: "uri"
      h: "Permalink"
      n: "permalink"
      r: false
      sh: "Permanent link to this Woody"
      t: "`$STRING`"
    }
    url: {
      fo: "uri"
      h: "Url"
      n: "url"
      r: false
      sh: "URL to the Woody image"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "api"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /api/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/api/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "api"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
